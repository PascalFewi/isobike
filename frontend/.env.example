# Copy to .env.local for local development (that file is git-ignored).
# Defaults (src/config.ts) already match `npx wrangler dev` on :8787 and the
# tile server on :8788, so .env.local is only needed to point elsewhere.
# A value starting with "/" means "same host as the page" (see .env.production).

VITE_WORKER_URL=http://localhost:8787
VITE_PMTILES_URL=http://localhost:8788/network.pmtiles
