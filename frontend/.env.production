# Production build (Hetzner): frontend, API and tiles share one origin.
# Caddy routes /api/* to the routing server and /data/* to the data files.
VITE_WORKER_URL=/api
VITE_PMTILES_URL=/data/network.pmtiles
VITE_POIS_URL=/data/pois.pmtiles

# Usage statistics (self-hosted Umami at stats.isobike.ch, no cookies; see
# deploy/README.md and src/lib/analytics.ts). Paste the website ID from the
# Umami dashboard; while it is empty nothing is loaded. The ID is public (it is
# in the page source), not a secret.
VITE_UMAMI_WEBSITE_ID=6e97ce59-5abf-410e-9b8b-93bfa989a465
VITE_UMAMI_SCRIPT_URL=https://stats.isobike.ch/script.js
VITE_UMAMI_DOMAINS=isobike.ch,www.isobike.ch
