# Caddy in front of isobike: static frontend, public map data, and the routing
# API. Installed to /etc/caddy/Caddyfile by deploy/setup-server.sh.
#
# Served on isobike.ch and www.isobike.ch (DNS A/AAAA -> the Hetzner server).
# Caddy gets and renews the Let's Encrypt certificates on its own and redirects
# HTTP to HTTPS. Before the DNS points here, use ":80" instead to serve plain
# HTTP on the server's IP.

{
	# Contact for certificate expiry notices. Optional; set it on the server
	# only -- this repo is public, and an address here would be scraped.
	# email you@example.com
}

isobike.ch, www.isobike.ch {
	# Routing API -> Node on localhost. /api is stripped: /api/route -> /route.
	handle_path /api/* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8080
	}

	# Only the files the browser needs are public; graph.bin and geometry.bin
	# stay private to the API (they are 100-200 MB each).
	@public_data path /data/network.pmtiles /data/meta.json
	handle @public_data {
		uri strip_prefix /data
		root * /opt/isobike/data
		# PMTiles is read with range requests; its tiles are already compressed.
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle /data/* {
		respond 404
	}

	# Live visitor stats (GoAccess, deploy/goaccess.service), password only.
	# The login comes from /etc/caddy/stats.env on the server (deploy/caddy-stats.conf);
	# without it, the fallback is the hash of a random password nobody knows, so
	# /stats stays locked instead of Caddy failing to start.
	redir /stats /stats/
	handle_path /stats/* {
		basic_auth {
			{$STATS_USER:stats} {$STATS_PASS_HASH:$2a$14$yom3urmlTvNbEAo27SD2AOu84BkOLB6cuqbQc56NF5rRKKr2u5cpm}
		}
		reverse_proxy /ws 127.0.0.1:7890
		root * /var/lib/goaccess/www
		file_server
	}

	# The single-page frontend of the active release.
	handle {
		root * /opt/isobike/current/frontend
		encode zstd gzip
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/isobike.log
	}
}
